{
  "name": "multicloud-iam-codex-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "next dev",
    "start": "node dist/server.js",
    "start:web": "next start",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.server.json",
    "build:web": "next build",
    "lint": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.68.0",
    "@tanstack/react-table": "^8.21.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "lucide-react": "^0.511.0",
    "next": "^15.3.0",
    "openai": "^5.12.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.3.0",
    "zustand": "^5.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
